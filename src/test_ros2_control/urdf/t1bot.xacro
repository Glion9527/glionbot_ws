<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="t1bot">
    <link name="base_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <geometry>
                <cylinder radius="1.0" length="1.0" />
            </geometry>
            <material name="red">
                <color rgba="1.0 0.0 0.0 1.0" />
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <geometry>
                <cylinder radius="1.0" length="1.0" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="1.0" />
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1" />
        </inertial>
    </link>
    <link name="link1">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 1.0" />
            <geometry>
                <box size="0.5 0.5 0.5" />
            </geometry>
            <material name="y">
                <color rgba="0.0 1.0 0.0 1.0" />
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 1.0" />
            <geometry>
                <box size="0.5 0.5 0.5" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="1.0" />
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1" />
        </inertial>
    </link>
    <joint name="joint1" type="continuous">
        <parent link="base_link" />
        <child link="link1" />
        <origin xyz="0 0 1" rpy="0 0 0" />
        <axis xyz="0 0 1" />
    </joint>
</robot>