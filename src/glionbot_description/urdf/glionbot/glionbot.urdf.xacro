<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="glionbot">
    <xacro:include filename="$(find glionbot_description)/urdf/glionbot/base.urdf.xacro" />
    <xacro:base_xacro length="0.12" radius="0.1" />
    <!-- 传感器组件-->
    <xacro:include filename="$(find glionbot_description)/urdf/glionbot/sensor/imu.urdf.xacro" />
    <xacro:include filename="$(find glionbot_description)/urdf/glionbot/sensor/laser.urdf.xacro" />
    <xacro:include filename="$(find glionbot_description)/urdf/glionbot/sensor/camera.urdf.xacro" />
    <!-- 执行器组件-->
    <xacro:include filename="$(find glionbot_description)/urdf/glionbot/actuator/wheel.urdf.xacro" />
    <xacro:include filename="$(find glionbot_description)/urdf/glionbot/actuator/caster.urdf.xacro" />
    <!-- 传感器-->
    <xacro:imu_xacro xyz="0.0 0.0 0.02" m="0.5" w="0.02" h="0.02" d="0.02" />
    <xacro:laser_xacro xyz="0.0 0.0 0.10" />
    <xacro:camera_xacro xyz="0.10 0.0 0.075" m="0.5" w="0.02" h="0.10" d="0.02" />
    <!-- 执行器主动轮+从动轮-->
    <xacro:wheel_xacro wheel_name="left" xyz="0.0 0.10 -0.06" radius="0.032" length="0.04" />
    <xacro:wheel_xacro wheel_name="right" xyz="0.0 -0.10 -0.06" radius="0.032" length="0.04" />
    <xacro:caster_xacro caster_name="front" xyz="0.08 0.0 -0.076" r="0.016" />
    <xacro:caster_xacro caster_name="back" xyz="-0.08 0.0 -0.076" r="0.016" />
    <!-- Gazebo插件-->
    <xacro:include
        filename="$(find glionbot_description)/urdf/glionbot/plugins/gazebo_control_plugin.xacro" />
    <xacro:gazebo_control_plugin />
    <xacro:include
        filename="$(find glionbot_description)/urdf/glionbot/plugins/gazebo_sensor_plugin.xacro" />
    <xacro:gazebo_sensor_plugin />
    <!-- 1. 引入硬件接口 -->
    <xacro:include filename="$(find glionbot_description)/urdf/glionbot/glionbot.ros2_control.xacro" />
    <xacro:glionbot_ros2_control />
</robot>